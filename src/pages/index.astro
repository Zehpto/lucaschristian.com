---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    timeZone: 'UTC',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title="Lucas Christian | Staff Enterprise Security Engineer | Seattle" description="Lucas Christian is a Staff Security Engineer at Databricks in the Seattle area, specializing in enterprise security, endpoint protection, SSPM, and zero trust.">
  <Navigation />
  
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="space-y-6">
        <!-- Terminal Prompt -->
        <div class="flex items-center space-x-2 font-mono text-sm text-gray-500">
          <span class="text-emerald-400">lucas@security</span>
          <span>:</span>
          <span class="text-blue-400">~</span>
          <span>$</span>
          <span class="text-gray-400">whoami</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-5xl md:text-7xl font-bold">
          <span class="text-gray-100">Lucas</span>
          <span class="text-emerald-400"> Christian</span>
        </h1>

        <!-- Tagline -->
        <p class="text-xl md:text-2xl text-gray-400 max-w-2xl">
          Staff Security Engineer | Enterprise Security<span class="cursor-blink">_</span>
        </p>

        <!-- Description -->
        <p class="text-gray-500 max-w-2xl leading-relaxed">
          I’m Lucas Christian, a Staff Security Engineer at Databricks in the Greater Seattle Area.
          I build and scale enterprise security programs across endpoint security, SaaS Security Posture Management (SSPM), zero-trust access, and security automation.
        </p>

        <p class="font-mono text-sm text-emerald-300">CISSP &amp; OSCP certified · Databricks · Previously Uber and SIG</p>
        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a 
            href="https://drive.google.com/file/d/1GFiR3HzvKCexj-5M4steNWDCpsjiT_j9/preview"
            class="px-6 py-3 bg-emerald-500 text-gray-950 font-mono text-sm font-semibold rounded-lg hover:bg-emerald-400 transition-all hover:shadow-lg hover:shadow-emerald-400/50"
          >
            View Resume
          </a>
          <a 
            href="/about" 
            class="px-6 py-3 bg-gray-800/50 text-gray-100 font-mono text-sm font-medium rounded-lg border border-gray-700 hover:bg-gray-800 hover:border-emerald-400/50 transition-all"
          >
            About Me
          </a>
          <a href="https://www.linkedin.com/in/lucaschristian/" class="px-6 py-3 text-emerald-300 font-mono text-sm hover:underline">LinkedIn ↗</a>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12" aria-labelledby="expertise">
      <h2 id="expertise" class="text-3xl font-bold mb-3">Security that works at enterprise scale.</h2>
      <p class="text-gray-400 max-w-2xl mb-8">From platform ownership to architecture reviews, I turn security requirements into practical controls and sustainable programs.</p>
      <div class="grid md:grid-cols-3 gap-4">
        <article class="p-6 rounded-lg border border-gray-800 bg-gray-900/50"><p class="text-emerald-400 font-mono text-sm mb-4">01 / ENDPOINTS</p><h3 class="text-xl font-semibold mb-3">Endpoint security</h3><p class="text-gray-400">Enterprise Endpoint Detection and Response (EDR), device posture, and zero-trust access controls.</p></article>
        <article class="p-6 rounded-lg border border-gray-800 bg-gray-900/50"><p class="text-emerald-400 font-mono text-sm mb-4">02 / SAAS</p><h3 class="text-xl font-semibold mb-3">SaaS security</h3><p class="text-gray-400">SSPM programs, third-party application assessments, and remediation in partnership with application owners.</p></article>
        <article class="p-6 rounded-lg border border-gray-800 bg-gray-900/50"><p class="text-emerald-400 font-mono text-sm mb-4">03 / ENGINEERING</p><h3 class="text-xl font-semibold mb-3">Automation &amp; leadership</h3><p class="text-gray-400">AI-assisted architecture reviews, security roadmaps, technical mentoring, and secure M&amp;A integrations.</p></article>
      </div>
    </section>
    <!-- Selected writing -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-100">Selected Writing</h2>
        <a href="/blog" class="text-emerald-400 hover:text-emerald-300 font-mono text-sm transition-colors">
          view all →
        </a>
      </div>
      
      <div class="grid gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post-card block">
            <article>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <h3 class="text-xl font-bold text-gray-100">
                  {post.data.title}
                </h3>
                <time class="text-gray-500 font-mono text-sm whitespace-nowrap">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              <p class="text-gray-400 leading-relaxed">
                {post.data.description}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
